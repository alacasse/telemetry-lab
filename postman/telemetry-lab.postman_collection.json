{
  "info": {
    "_postman_id": "1e56ec0a-0a29-4c8a-bc88-2cbe1b030001",
    "name": "Telemetry Lab API",
    "description": "Postman collection for the Telemetry Lab ingestion and query APIs. URLs are built from environment variables so the same requests can target Local or AWS without editing the requests themselves.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const stagingToken = pm.environment.get('stagingToken') || '';",
          "if (stagingToken) {",
          "  pm.request.headers.upsert({ key: 'X-Staging-Token', value: stagingToken });",
          "} else {",
          "  pm.request.headers.remove('X-Staging-Token');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const allowRetryableStatus = String(pm.variables.get('allowRetryableStatus') || 'false').toLowerCase() === 'true';",
          "const retryableStatusCodes = String(pm.variables.get('retryableStatusCodes') || '')",
          "  .split(',')",
          "  .map(function (value) { return Number.parseInt(value.trim(), 10); })",
          "  .filter(function (value) { return Number.isFinite(value); });",
          "if (allowRetryableStatus && retryableStatusCodes.includes(pm.response.code)) {",
          "  return;",
          "}",
          "pm.test('Status code is 2xx', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "collectionName",
      "value": "Telemetry Lab API"
    }
  ],
  "item": [
    {
      "name": "Ingestion Service",
      "description": "Endpoints exposed by the ingestion service.",
      "item": [
        {
          "name": "Health",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
