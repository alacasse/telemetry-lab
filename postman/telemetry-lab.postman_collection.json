          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Health status is ok', function () {",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});",
                  "pm.test('Service name is ingestion-service', function () {",
                  "  pm.expect(json.service).to.eql('ingestion-service');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest Telemetry",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "disabled": true,
                "description": "Enable to force a caller-provided correlation ID."
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"building_id\": \"{{telemetryBuildingId}}\",\n  \"zone_id\": \"{{telemetryZoneId}}\",\n  \"timestamp\": \"{{telemetryTimestamp}}\",\n  \"temperature_c\": {{temperatureC}},\n  \"humidity_pct\": {{humidityPct}},\n  \"occupancy\": {{occupancy}},\n  \"co2_ppm\": {{co2Ppm}},\n  \"hvac_mode\": \"{{hvacMode}}\",\n  \"airflow_pct\": {{airflowPct}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}{{ingestionServicePrefix}}/telemetry",
            "description": "Submits a telemetry event to the queue-backed ingestion pipeline."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Telemetry is accepted', function () {",
                  "  pm.expect(json.status).to.eql('accepted');",
                  "});",
                  "pm.test('Response contains event and correlation identifiers', function () {",
                  "  pm.expect(json.event_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.correlation_id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('createdEventId', json.event_id);",
                  "pm.environment.set('correlationId', json.correlation_id);",
                  "pm.environment.set('buildingId', pm.environment.get('telemetryBuildingId'));",
                  "pm.environment.set('zoneId', pm.environment.get('telemetryZoneId'));"
                ]
              }
            }
          ]
        }
      ]
    },
