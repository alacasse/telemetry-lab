    {
      "name": "AWS Smoke",
      "description": "Post-deploy contract smoke flow for the staging endpoint.",
      "item": [
        {
          "name": "Health",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/health",
            "description": "Verifies the public staging health endpoint exposed through the query Lambda."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Health status is ok', function () {",
                  "  pm.expect(json.status).to.eql('ok');",
                  "});",
                  "pm.test('Health endpoint is served by query-service', function () {",
                  "  pm.expect(json.service).to.eql('query-service');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ingest Telemetry",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"building_id\": \"{{telemetryBuildingId}}\",\n  \"zone_id\": \"{{telemetryZoneId}}\",\n  \"timestamp\": \"{{telemetryTimestamp}}\",\n  \"temperature_c\": {{temperatureC}},\n  \"humidity_pct\": {{humidityPct}},\n  \"occupancy\": {{occupancy}},\n  \"co2_ppm\": {{co2Ppm}},\n  \"hvac_mode\": \"{{hvacMode}}\",\n  \"airflow_pct\": {{airflowPct}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/telemetry",
            "description": "Creates a fresh telemetry event for the contract smoke run."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Telemetry is accepted', function () {",
                  "  pm.expect(json.status).to.eql('accepted');",
                  "});",
                  "pm.test('Response contains event and correlation identifiers', function () {",
                  "  pm.expect(json.event_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.correlation_id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('createdEventId', json.event_id);",
                  "pm.environment.set('correlationId', json.correlation_id);",
                  "pm.environment.set('buildingId', pm.environment.get('telemetryBuildingId'));",
                  "pm.environment.set('zoneId', pm.environment.get('telemetryZoneId'));",
                  "pm.environment.set('smokeStateAttempt', '0');",
                  "pm.environment.set('smokeEventAttempt', '0');",
                  "pm.environment.set('smokeDecisionAttempt', '0');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Building State",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            },
            {
              "key": "allowRetryableStatus",
              "value": "true"
            },
            {
              "key": "retryableStatusCodes",
              "value": "404"
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/buildings/{{buildingId}}/state",
            "description": "Polls until the newly ingested telemetry is visible through the state projection."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attemptKey = 'smokeStateAttempt';",
                  "const maxAttempts = Number.parseInt(pm.environment.get('smokeMaxAttempts') || '20', 10);",
                  "const currentAttempt = Number.parseInt(pm.environment.get(attemptKey) || '0', 10);",
                  "const retry = function (message) {",
                  "  if (currentAttempt + 1 >= maxAttempts) {",
                  "    pm.environment.unset(attemptKey);",
                  "    throw new Error(message);",
                  "  }",
                  "  pm.environment.set(attemptKey, String(currentAttempt + 1));",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "};",
                  "if (pm.response.code === 404) {",
                  "  retry('Building state did not become available before the smoke timeout');",
                  "  return;",
                  "}",
                  "const json = pm.response.json();",
                  "const telemetryTimestamp = Date.parse(pm.environment.get('telemetryTimestamp') || '');",
                  "const lastProcessedAt = json.last_processed_at ? Date.parse(json.last_processed_at) : Number.NaN;",
                  "if (!Number.isFinite(lastProcessedAt) || lastProcessedAt < telemetryTimestamp) {",
                  "  retry('Building state did not reflect the new telemetry event before the smoke timeout');",
                  "  return;",
                  "}",
                  "pm.environment.unset(attemptKey);",
                  "pm.test('Response matches the selected building', function () {",
                  "  pm.expect(json.building_id).to.eql(pm.environment.get('buildingId'));",
                  "});",
                  "pm.test('State reflects the current smoke event', function () {",
                  "  pm.expect(lastProcessedAt).to.be.at.least(telemetryTimestamp);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Building Events",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/buildings/{{buildingId}}/events?limit={{queryLimit}}",
            "description": "Polls until the event list contains the freshly ingested telemetry event."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attemptKey = 'smokeEventAttempt';",
                  "const maxAttempts = Number.parseInt(pm.environment.get('smokeMaxAttempts') || '20', 10);",
                  "const currentAttempt = Number.parseInt(pm.environment.get(attemptKey) || '0', 10);",
                  "const json = pm.response.json();",
                  "const items = Array.isArray(json.items) ? json.items : [];",
                  "const latestItem = items[0];",
                  "const createdEventId = pm.environment.get('createdEventId');",
                  "const isReady = Boolean(latestItem) && latestItem.event_id === createdEventId && latestItem.processing_status === 'processed';",
                  "if (!isReady) {",
                  "  if (currentAttempt + 1 >= maxAttempts) {",
                  "    pm.environment.unset(attemptKey);",
                  "    throw new Error('Event list did not expose the processed smoke event before the timeout');",
                  "  }",
                  "  pm.environment.set(attemptKey, String(currentAttempt + 1));",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.environment.unset(attemptKey);",
                  "pm.environment.set('latestEventId', latestItem.event_id);",
                  "pm.environment.set('latestProcessingStatus', latestItem.processing_status);",
                  "pm.test('Events response matches the selected building', function () {",
                  "  pm.expect(json.building_id).to.eql(pm.environment.get('buildingId'));",
                  "});",
                  "pm.test('Latest event matches the ingested telemetry event', function () {",
                  "  pm.expect(latestItem.event_id).to.eql(createdEventId);",
                  "  pm.expect(latestItem.zone_id).to.eql(pm.environment.get('zoneId'));",
                  "  pm.expect(latestItem.processing_status).to.eql('processed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Building Decisions",
          "variable": [
            {
              "key": "requiresAuth",
              "value": "false"
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/buildings/{{buildingId}}/decisions?limit={{queryLimit}}",
            "description": "Polls until a decision produced by the worker is visible for the smoke event building."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attemptKey = 'smokeDecisionAttempt';",
                  "const maxAttempts = Number.parseInt(pm.environment.get('smokeMaxAttempts') || '20', 10);",
                  "const currentAttempt = Number.parseInt(pm.environment.get(attemptKey) || '0', 10);",
                  "const json = pm.response.json();",
                  "const items = Array.isArray(json.items) ? json.items : [];",
                  "const latestItem = items[0];",
                  "const telemetryTimestamp = Date.parse(pm.environment.get('telemetryTimestamp') || '');",
                  "const generatedAt = latestItem && latestItem.generated_at ? Date.parse(latestItem.generated_at) : Number.NaN;",
                  "const isReady = Boolean(latestItem) && latestItem.zone_id === pm.environment.get('zoneId') && Number.isFinite(generatedAt) && generatedAt >= telemetryTimestamp;",
                  "if (!isReady) {",
                  "  if (currentAttempt + 1 >= maxAttempts) {",
                  "    pm.environment.unset(attemptKey);",
                  "    throw new Error('Decision list did not expose a fresh worker decision before the timeout');",
                  "  }",
                  "  pm.environment.set(attemptKey, String(currentAttempt + 1));",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "  return;",
                  "}",
                  "pm.environment.unset(attemptKey);",
                  "pm.environment.set('decisionId', latestItem.decision_id);",
                  "pm.test('Decisions response matches the selected building', function () {",
                  "  pm.expect(json.building_id).to.eql(pm.environment.get('buildingId'));",
                  "});",
                  "pm.test('Latest decision matches the smoke event zone', function () {",
                  "  pm.expect(latestItem.decision_id).to.be.a('string').and.not.empty;",
                  "  pm.expect(latestItem.zone_id).to.eql(pm.environment.get('zoneId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
