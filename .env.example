# Existing Compose/service configuration. scripts/demo-local.sh uses isolated local settings
# and deliberately does not load this file or .env.
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://telemetry_lab:telemetry_lab@localhost:5432/telemetry_lab
QUEUE_BACKEND=sqs
QUEUE_NAME=telemetry-ingestion-queue
AWS_REGION=ca-central-1
AWS_ENDPOINT_URL=http://localhost:4566
WORKER_RECEIVE_WAIT_SECONDS=20
WORKER_IDLE_SLEEP_SECONDS=0
WORKER_MAX_MESSAGES=10
SIMULATOR_BATCH_INTERVAL_SECONDS=0.1
SIMULATOR_CONTINUOUS_INTERVAL_SECONDS=1.0
INGESTION_BASE_URL=http://localhost:8000
QUERY_BASE_URL=http://localhost:8001
EVENT_MAX_FUTURE_MINUTES=15
EVENT_MAX_PAST_DAYS=7
